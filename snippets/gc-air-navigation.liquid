{% doc %}
  Coordinates the Air global header, product navigation and optional campaign bar.
{% enddoc %}
<style>
  .gc-air-navigation {
    --gc-air-header-height: 64px;
    --gc-air-product-height: 49px;
    --gc-air-offer-height: 0px;
  }
  .gc-air-navigation #shopify-section-header.shopify-section--header {
    position: relative;
    top: 0 !important;
    z-index: 50;
  }
  .gc-air-navigation store-header.header {
    position: relative !important;
    top: 0 !important;
    animation: none;
  }
  .gc-air-navigation #shopify-section-header.gc-air-header-away {
    visibility: hidden;
    pointer-events: none;
  }
  .gc-air-navigation .gc-air-header-away .gc-mega-host {
    visibility: hidden !important;
  }
  .gc-air-navigation .ts-topbar {
    top: calc(var(--gc-air-offer-height) + var(--gc-air-header-visible, var(--gc-air-header-height))) !important;
    z-index: 40;
    background: rgba(29, 29, 31, .94);
  }
  .gc-air-navigation #shopify-section-header.shopify-section--header:has(.drawer[open]),
  .gc-air-navigation .drawer {
    z-index: 80;
  }
  .gc-air-navigation .header [aria-controls="newsletter-popup"] {
    display: none !important;
  }
  .gc-air-navigation .ts-topbar__in {
    max-width: none;
    padding-left: var(--gc-air-content-left, var(--container-gutter, 32px));
    padding-right: var(--gc-air-content-right, var(--container-gutter, 32px));
  }
  .gc-air-navigation .ts-topbar__name {
    margin-left: 0;
    margin-right: auto;
    cursor: pointer;
  }
  .gc-air-navigation .ts-topbar__name:hover {
    color: #fff;
  }
  .gc-air-navigation .ts-topbar__name:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
  .gc-air-navigation #main [id] {
    scroll-margin-top: calc(var(--gc-air-offer-height) + var(--gc-air-product-height) + 16px);
  }
  .gc-air-navigation .gc-mega__panes {
    max-height: calc(100dvh - var(--gc-air-offer-height) - var(--gc-air-header-height) - 180px);
  }
  @media (min-width: 741px) {
    .gc-air-navigation .header .header__wrapper {
      height: 63px;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
  }
  @media (max-width: 740px) {
    .gc-air-navigation { --gc-air-header-height: 55px; }
  }
  @media (max-width: 560px) {
    .gc-air-navigation { --gc-air-product-height: 45px; }
  }
</style>
<script>
  (function () {
    function init() {
      var body = document.body;
      var header = document.querySelector('#shopify-section-header.shopify-section--header');
      var product = document.querySelector('.ts-topbar');
      if (!header || !product || body.dataset.gcAirNavReady) return;
      body.dataset.gcAirNavReady = 'true';
      var offer = null;
      var frame = 0;
      function set(name, value) {
        var next = value + 'px';
        if (body.style.getPropertyValue(name) !== next) body.style.setProperty(name, next);
      }
      function measure() {
        frame = 0;
        var rect = header.getBoundingClientRect();
        var offerHeight = offer ? offer.getBoundingClientRect().height : 0;
        var visible = Math.max(0, Math.min(rect.height, rect.bottom - offerHeight));
        var logo = header.querySelector('.header__logo');
        var wrapper = header.querySelector('.header__wrapper');
        set('--gc-air-header-height', rect.height);
        set('--gc-air-header-visible', visible);
        set('--gc-air-product-height', product.getBoundingClientRect().height);
        set('--gc-air-offer-height', offerHeight);
        if (logo) set('--gc-air-content-left', logo.getBoundingClientRect().left);
        if (wrapper) set('--gc-air-content-right', Math.max(0, document.documentElement.clientWidth - wrapper.getBoundingClientRect().right));
        header.classList.toggle('gc-air-header-away', visible === 0);
      }
      function schedule() {
        if (!frame) frame = requestAnimationFrame(measure);
      }
      var observer = window.ResizeObserver ? new ResizeObserver(schedule) : null;
      function findOffer() {
        var next = document.querySelector('.gct-bar');
        if (offer === next) return;
        if (observer && offer) observer.unobserve(offer);
        offer = next;
        if (observer && offer) observer.observe(offer);
        measure();
      }
      if (observer) {
        observer.observe(header);
        observer.observe(product);
      }
      new MutationObserver(findOffer).observe(body, { childList: true });
      window.addEventListener('resize', schedule, { passive: true });
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('pageshow', schedule);
      var topLink = product.querySelector('[data-gc-air-top]');
      if (topLink) topLink.addEventListener('click', function (event) {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      });
      findOffer();
      measure();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
    else init();
  })();
</script>
