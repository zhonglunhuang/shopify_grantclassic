{% doc %}
  Displays an installment estimate based on the discounted cart total.
{% enddoc %}
{% if cart.item_count > 0 and cart.total_price > 0 and cart.currency.iso_code == 'TWD' %}
  {% assign installment_amount = cart.total_price | divided_by: 600 | times: 100 %}
  <div class="gc-cart-installment" role="status" aria-live="polite">
    <p class="gc-cart-installment__amount"><span class="gc-cart-installment__plan">{{ 'gc_installment.plan' | t }}</span><span>{{ 'gc_installment.cart_monthly' | t }} <strong>{{ installment_amount | money_without_currency }}</strong></span></p>
    <p class="gc-cart-installment__hint">{{ 'gc_installment.cart_hint' | t }}</p>
    <details class="gc-cart-installment__details"><summary>{{ 'gc_installment.details' | t }}</summary><p>{{ 'gc_installment.cart_terms' | t }}</p></details>
  </div>
  <style>
    .gc-cart-installment { margin: 18px 0 0; padding: 16px; border-radius: 12px; background: #f5f5f7; color: #1d1d1f; text-align: left; }
    .gc-cart-installment .gc-cart-installment__amount { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; margin: 0; font-size: 15px; line-height: 1.5; }
    .gc-cart-installment__plan { font-size: 13px; font-weight: 600; }
    .gc-cart-installment__amount strong { font-size: 18px; font-weight: 600; font-variant-numeric: tabular-nums; }
    .gc-cart-installment .gc-cart-installment__hint { margin: 7px 0 0; color: #515156; font-size: 12px; line-height: 1.6; }
    .gc-cart-installment__details summary { width: fit-content; padding: 6px 0 0; font-size: 12px; color: #515156; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
    .gc-cart-installment__details summary:focus-visible { outline: 2px solid #006edb; outline-offset: 3px; }
    .gc-cart-installment__details p { margin: 8px 0 0; font-size: 12px; line-height: 1.6; color: #515156; }
    .mini-cart__drawer-footer .gc-cart-installment { margin: 0 0 14px; padding: 12px 14px; }
  </style>
{% endif %}
