        { "type": "row", "settings": { "label": "溫度保護", "a": "NTC 感測降載", "m": "NTC 感測降載", "b": "NTC 感測降載", "win": "none" } },
        { "type": "row", "settings": { "label": "建議售價", "a": "NT$1,980", "m": "NT$1,980 起", "b": "NT$2,980", "win": "none" } }
