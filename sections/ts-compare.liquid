        { "type": "row", "settings": { "label": "重量", "a": "113 g", "m": "155／255 g", "b": "待補", "win": "a" } },
        { "type": "row", "settings": { "label": "無線輸出", "a": "磁吸 15W", "m": "15W", "b": "Qi2.2 磁吸 25W", "win": "b" } },
        { "type": "row", "settings": { "label": "有線輸出", "a": "18W", "m": "20W", "b": "30W", "win": "b" } },
        { "type": "row", "settings": { "label": "Apple Watch 充電", "a": "—", "m": "✓", "b": "—", "win": "m" } },
        { "type": "row", "settings": { "label": "電量顯示", "a": "—", "m": "—", "b": "TFT 數位螢幕", "win": "b" } },
        { "type": "row", "settings": { "label": "折疊支架", "a": "—", "m": "—", "b": "隱藏式支架", "win": "b" } },
        { "type": "row", "settings": { "label": "防爆警鈴", "a": "—", "m": "—", "b": "有", "win": "b" } },
