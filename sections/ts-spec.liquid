{{ 'ts-air.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  2026-08-19（Mars 要求）：規格表原本整張寫死在這裡、後台改不了字——
  改成每一列都是 block（項目＋內容），折疊說明（安全測試等）也是 block，
  Mars 在主題編輯器就能自由改字、增刪、拖曳排序。
  現有內容已搬進 templates/product.ts-air.json 的 blocks（防塵收納袋同批拿掉）。
{%- endcomment -%}
<div class="ts-air">
<section class="sect light" id="spec">
  <div class="wrap">
    <h2 class="rise">{{ section.settings.heading | newline_to_br }}</h2>
    <p class="lede rise" data-d="1">{{ section.settings.lede | newline_to_br }}</p>

    <dl class="spec rise" data-d="2" style="margin-top:52px">
      {%- for block in section.blocks -%}
        {%- if block.type == 'row' -%}
          <div class="spec__row" {{ block.shopify_attributes }}>
            <dt>{{ block.settings.label }}</dt><dd>{{ block.settings.value | newline_to_br }}</dd>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dl>

    {%- assign folds = section.blocks | where: 'type', 'fold' -%}
    {%- if folds.size > 0 -%}
    <div style="margin-top:48px">
      {%- for block in folds -%}
        <details class="fold" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.title }}</summary>
          <div style="padding-bottom:26px">
            <p class="small">{{ block.settings.text | newline_to_br }}</p>
          </div>
        </details>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>
</div>

<script src="{{ 'ts-air.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "TS Air 完整規格",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "標題（換行=Enter）", "default": "全部的數字。" },
    { "type": "textarea", "id": "lede", "label": "說明", "default": "說明書上寫的每一項，原封不動列在這裡。" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "規格列",
      "settings": [
        { "type": "text", "id": "label", "label": "項目（左欄）" },
        { "type": "textarea", "id": "value", "label": "內容（右欄）" }
      ]
    },
    {
      "type": "fold",
      "name": "折疊說明",
      "settings": [
        { "type": "text", "id": "title", "label": "標題" },
        { "type": "textarea", "id": "text", "label": "內文" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TS Air 完整規格"
    }
  ]
}
{% endschema %}
