{{ 'ts-coll.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  分類頁「延伸閱讀」v2（2026-08-26 Mars 核可模擬稿後改版）：Apple 式橫滑卡片列——
  起點對齊內容欄左緣、尾端延伸出畫面右緣、滑鼠按住可拖、右下 ‹ › 圓鈕、卡位自動對齊。
  目的不變：分類頁權重灌給文章、文章流量回導商品（SEO/GEO），文章用後台選擇器挑（最多 6 篇）。
  兩個踩過的坑直接帶進來：①捲動容器會把垂直溢出一起裁掉——上下留呼吸墊再用負邊距吸回，
  浮起與陰影才不會被切；②snap 會忽略容器內距把起點吸走——要配 scroll-padding-left。
{%- endcomment -%}
<style>
  /* 起點對齊 .ts-coll__w（1024px＋22px 內距）的左緣；選擇器多包一層防後段蓋掉 */
  .ts-coll .ts-coll__rail{
    --tsr-gut:max(22px, calc((100vw - 1024px) / 2 + 22px));
    margin-top:calc(clamp(28px,4vw,44px) - 16px);
    overflow-x:auto;overscroll-behavior-x:contain;
    scroll-snap-type:x mandatory;scroll-padding-left:var(--tsr-gut);
    scrollbar-width:none;-webkit-overflow-scrolling:touch;
    padding:16px var(--tsr-gut) 44px;margin-bottom:-30px;
    display:flex;gap:20px;cursor:grab;}
  .ts-coll .ts-coll__rail::-webkit-scrollbar{display:none;}
  .ts-coll .ts-coll__rail.dragging{cursor:grabbing;scroll-snap-type:none;}
  .ts-coll .ts-coll__read{flex:0 0 min(340px,78vw);scroll-snap-align:start;
    display:block;background:#FFFFFF;border-radius:18px;overflow:hidden;
    text-decoration:none;color:inherit;
    border:1px solid rgba(0,0,0,.07);
    box-shadow:0 1px 3px rgba(0,0,0,.04);
    transition:transform .3s cubic-bezier(.2,.6,.25,1),box-shadow .3s;}
  .ts-coll .ts-coll__read:hover{transform:translateY(-6px);
    box-shadow:0 16px 34px rgba(0,0,0,.12);}
  .ts-coll .ts-coll__read:hover,.ts-coll .ts-coll__read:hover *{text-decoration:none;}
  .ts-coll .ts-coll__read-img{display:block;aspect-ratio:16/10;background:#F2F2F4;}
  .ts-coll .ts-coll__read-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .ts-coll .ts-coll__read-body{display:block;padding:18px 20px 22px;}
  .ts-coll .ts-coll__read-title{display:block;font-size:16.5px;font-weight:650;
    line-height:1.45;letter-spacing:-.01em;}
  .ts-coll .ts-coll__read-ex{display:-webkit-box;-webkit-line-clamp:2;
    -webkit-box-orient:vertical;overflow:hidden;
    margin-top:8px;font-size:13.5px;line-height:1.7;color:#6E6E73;}
  .ts-coll .ts-coll__read-cta{display:inline-block;margin-top:12px;font-size:13.5px;
    font-weight:600;color:#0071E3;}
  .ts-coll .ts-coll__railctrl{display:flex;justify-content:flex-end;gap:12px;
    margin-top:18px;}
  .ts-coll .ts-coll__railctrl button{width:38px;height:38px;border-radius:50%;border:0;
    cursor:pointer;background:#E8E8ED;color:#1D1D1F;font-size:18px;line-height:1;
    display:flex;align-items:center;justify-content:center;
    transition:background .2s,opacity .2s;}
  .ts-coll .ts-coll__railctrl button:hover{background:#DCDCE1;}
  .ts-coll .ts-coll__railctrl button:disabled{opacity:.35;cursor:default;}
  @media (max-width:760px){
    .ts-coll .ts-coll__rail{--tsr-gut:16px;}
  }
</style>
<div class="ts-coll">
  <div class="ts-coll__band ts-coll__band--wash">
    <div class="ts-coll__w">
      <div class="ts-coll__head">
        <h2 class="ts-coll__h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.sub != blank -%}
          <p class="ts-coll__lead">{{ section.settings.sub | escape }}</p>
        {%- endif -%}
      </div>
    </div>
    {%- comment -%} 橫滑列刻意放在 __w 外面：滿版出血、起點用 CSS 對齊內容欄 {%- endcomment -%}
    <div class="ts-coll__rail" data-ts-rail>
      {%- for block in section.blocks -%}
        {%- assign a = block.settings.article -%}
        {%- if a != blank -%}
        <a class="ts-coll__read" href="{{ a.url }}" {{ block.shopify_attributes }}>
          {%- if a.image -%}
            <span class="ts-coll__read-img">
              {{ a.image | image_url: width: 720 | image_tag: loading: 'lazy', alt: a.title }}
            </span>
          {%- endif -%}
          <span class="ts-coll__read-body">
            <span class="ts-coll__read-title">{{ a.title | escape }}</span>
            <span class="ts-coll__read-ex">{{ a.excerpt_or_content | strip_html | truncatewords: 34 }}</span>
            <span class="ts-coll__read-cta">閱讀文章 ›</span>
          </span>
        </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="ts-coll__w">
      <div class="ts-coll__railctrl">
        <button type="button" data-ts-rail-prev aria-label="上一批">‹</button>
        <button type="button" data-ts-rail-next aria-label="下一批">›</button>
      </div>
    </div>
  </div>
</div>

<script>
/* 橫滑列：原生捲動＋滑鼠拖曳＋圓鈕。守門旗標防重複掛（同段落被引兩次時） */
if (!window.__tsCollRailInit) {
  window.__tsCollRailInit = 1;
  (function () {
    function start() {
      var rail = document.querySelector("[data-ts-rail]");
      if (!rail) return;
      var prev = document.querySelector("[data-ts-rail-prev]");
      var next = document.querySelector("[data-ts-rail-next]");
      var STEP = 360; /* 卡寬 340＋間距 20 */

      function updateBtns() {
        if (!prev) return;
        prev.disabled = rail.scrollLeft <= 4;
        next.disabled = rail.scrollLeft >= rail.scrollWidth - rail.clientWidth - 4;
      }
      if (prev) {
        prev.addEventListener("click", function () { rail.scrollBy({ left: -STEP * 2, behavior: "smooth" }); });
        next.addEventListener("click", function () { rail.scrollBy({ left: STEP * 2, behavior: "smooth" }); });
        rail.addEventListener("scroll", updateBtns, { passive: true });
        addEventListener("resize", updateBtns);
        updateBtns();
      }

      /* 滑鼠按住拖曳（觸控板與手機走原生捲動，不經過這段） */
      var down = false, startX = 0, startL = 0, moved = false;
      rail.addEventListener("pointerdown", function (e) {
        if (e.pointerType !== "mouse") return;
        down = true; moved = false; startX = e.clientX; startL = rail.scrollLeft;
        rail.classList.add("dragging");
      });
      addEventListener("pointermove", function (e) {
        if (!down) return;
        var dx = e.clientX - startX;
        if (Math.abs(dx) > 4) moved = true;
        rail.scrollLeft = startL - dx;
      });
      addEventListener("pointerup", function () {
        down = false; rail.classList.remove("dragging");
      });
      /* 拖曳過就別當點擊開連結 */
      rail.addEventListener("click", function (e) { if (moved) { e.preventDefault(); } }, true);
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start);
    } else { start(); }
  })();
}
</script>

{% schema %}
{
  "name": "TS 分類頁：延伸閱讀",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "標題", "default": "還在做功課？" },
    { "type": "textarea", "id": "sub", "label": "說明",
      "default": "行動電源的安全、挑選與固態技術，我們用實測寫給你看。" }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "文章",
      "settings": [
        { "type": "article", "id": "article", "label": "選文章",
          "info": "標題、圖片、摘要都自動抓，這裡只要挑哪一篇。" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "TS 分類頁：延伸閱讀" } ]
}
{% endschema %}
