{{ 'df.css' | asset_url | stylesheet_tag }}
{{ 'df-parts.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Dualfind 主視覺 —— 照 dji.com/tw/osmo-pocket-4p 的層級。

  DJI 的順序是：小標 → 產品名（最大）→ 標語 → 兩顆按鈕 → 產品圖在最下面。
  **文字不壓在產品照上**，這正是原本那版「文字跟背很難看」的原因：
  白字疊在淺色商品照上，怎麼調遮罩都是在補破網。

  底是深色漸層＋產品後面一團光暈（DJI 的高級感有一半來自這個），
  留一個背景圖欄位給實拍照用；沒放就用漸層，本來就好看。
{%- endcomment -%}

{%- comment -%}
  沒指定產品圖時，用內建的去背圖（assets/df-shot1.webp），不要用商品主圖——
  商品主圖是白底 JPEG，放在深色底上會變成一塊白方塊。
  內建圖是主題檔案不是商品圖，所以不能套 image_url，要直接 asset_url。
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign shot = s.shot -%}
{%- assign scrim = s.scrim | divided_by: 100.0 -%}

<div class="df df--dark"
     style="--df-accent:{{ s.accent }};--df-accent-dark:{{ s.accent_dark }};
            --dfhero-scrim:{{ scrim }};--dfhero-glow:{{ s.glow }};">
  <section class="dfhero {% if s.bg %}dfhero--photo{% endif %}" id="top">

    {%- if s.bg -%}
      <div class="dfhero__bg">
        <img src="{{ s.bg | image_url: width: 2400 }}"
             srcset="{{ s.bg | image_url: width: 900 }} 900w,
                     {{ s.bg | image_url: width: 1600 }} 1600w,
                     {{ s.bg | image_url: width: 2400 }} 2400w"
             sizes="100vw" alt="" aria-hidden="true"
             width="{{ s.bg.width }}" height="{{ s.bg.height }}"
             fetchpriority="high" decoding="async">
      </div>
    {%- endif -%}

    <div class="dfhero__txt">
      {%- if s.eyebrow != blank -%}
        <p class="dfhero__eye">{{ s.eyebrow }}</p>
      {%- endif -%}

      {%- comment -%} 產品名是最大的那一行（DJI 的 OSMO POCKET 4P 位置） {%- endcomment -%}
      <h1 class="dfhero__name {% if s.caps %}is-caps{% endif %}">{{ s.wordmark }}</h1>

      {%- if s.heading != blank -%}
        <p class="dfhero__line">{{ s.heading }}</p>
      {%- endif -%}

      <div class="df__btns" style="justify-content:center">
        {%- if s.b1 != blank -%}
          <a class="df__btn df__btn--fill" href="{{ s.b1_url | default: '#buy' }}">{{ s.b1 }}</a>
        {%- endif -%}
        {%- if s.b2 != blank -%}
          <a class="df__btn df__btn--ghost" href="{{ s.b2_url | default: '#overview' }}">{{ s.b2 }}</a>
        {%- endif -%}
      </div>

      {%- if s.show_price and product -%}
        <p class="dfhero__price">{{ s.price_prefix }}{{ product.price | money_without_trailing_zeros }} 起</p>
      {%- endif -%}
    </div>

    {%- comment -%} 產品圖在文字下面，後面墊一團光暈 {%- endcomment -%}
    <div class="dfhero__stage">
      {%- if shot -%}
        <img src="{{ shot | image_url: width: 1600 }}"
             srcset="{{ shot | image_url: width: 700 }} 700w,
                     {{ shot | image_url: width: 1100 }} 1100w,
                     {{ shot | image_url: width: 1600 }} 1600w"
             sizes="(max-width:900px) 92vw, 900px"
             alt="{{ s.shot_alt | default: product.title | escape }}"
             width="{{ shot.width }}" height="{{ shot.height }}"
             fetchpriority="high" decoding="async">
      {%- else -%}
        {%- comment -%} 高度收斂一點——太大的空框會蓋掉主標的氣勢 {%- endcomment -%}
        {%- render 'df-ph',
              label: s.ph_label,
              hint: s.ph_hint,
              ratio: 'width:min(100%,760px);height:clamp(240px,34vw,420px);' -%}
      {%- endif -%}
    </div>
  </section>
</div>

<script src="{{ 'df.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "DF 主視覺",
  "tag": "section",
  "class": "df-hero-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "最上面的小標", "default": "機車手機支架" },
    { "type": "text", "id": "wordmark", "label": "產品名（最大的那一行）", "default": "Dualfind" },
    { "type": "checkbox", "id": "caps", "label": "產品名全大寫", "default": true,
      "info": "跟 DJI 的 OSMO POCKET 4P 一樣。字距會自動放寬——大寫用小寫的字距會黏在一起。" },
    { "type": "text", "id": "heading", "label": "標語", "default": "騎車顧路，停車顧車。" },
    { "type": "checkbox", "id": "show_price", "label": "顯示售價", "default": true },
    { "type": "text", "id": "price_prefix", "label": "售價前綴", "default": "NT",
      "info": "金額本身已經帶一個 $ 符號，這裡只要填 NT——填 NT$ 會變成 NT$$1,780。" },

    { "type": "header", "content": "產品圖" },
    { "type": "image_picker", "id": "shot", "label": "產品圖",
      "info": "放在文字下面，不是背景。**用透明背景的去背圖**，白底圖會出現一塊白方塊。留空就用商品主圖。" },
    { "type": "text", "id": "shot_alt", "label": "產品圖替代文字" },
    { "type": "text", "id": "ph_label", "label": "沒放圖時顯示的標題", "default": "主視覺產品圖" },
    { "type": "text", "id": "ph_hint", "label": "沒放圖時顯示的說明",
      "default": "去背 PNG（透明背景）・正面偏斜角・不要陰影底" },
    { "type": "range", "id": "glow", "label": "產品後面的光暈", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55,
      "info": "深色底上讓產品浮起來的那團光。調 0 就沒有。" },

    { "type": "header", "content": "背景（選配）" },
    { "type": "image_picker", "id": "bg", "label": "背景照片",
      "info": "留空就用深色漸層——本來就好看，不一定要放圖。" },
    { "type": "range", "id": "scrim", "label": "背景照片壓暗程度", "min": 0, "max": 85, "step": 5, "unit": "%", "default": 55,
      "info": "只有放了背景照片才用得到。" },

    { "type": "header", "content": "按鈕" },
    { "type": "text", "id": "b1", "label": "左邊按鈕", "default": "購買" },
    { "type": "url",  "id": "b1_url", "label": "左邊按鈕連到哪", "info": "留空跳到購買區。" },
    { "type": "text", "id": "b2", "label": "右邊按鈕", "default": "進一步了解" },
    { "type": "url",  "id": "b2_url", "label": "右邊按鈕連到哪", "info": "留空跳到第一段。" },

    { "type": "header", "content": "顏色" },
    { "type": "color", "id": "accent", "label": "動作色（淺底）", "default": "#0071E3" },
    { "type": "color", "id": "accent_dark", "label": "動作色（深底）", "default": "#2997FF" }
  ],
  "presets": [{ "name": "DF 主視覺" }]
}
{% endschema %}
