<div class="tsp-pro"><div class="act-light">
<section class="sec" style="padding-top:clamp(84px,9vw,130px)" id="daily">
    <div class="wrap tft">
      <div class="sec-head center" style="margin-bottom:0">
        <p class="eyebrow" style="color:var(--act)">TFT 智慧螢幕</p>
        <h2 style="margin-top:10px" class="tft-h2">電量、溫度，一眼掌控。</h2>
        
        <p class="lede" style="max-width:none">電池健康、工作溫度、剩餘容量、無線功率、輸入／輸出與安全警示，即時顯示。</p>
      </div>
      <div class="tft-screen" id="tftscreen" aria-label="TFT 螢幕示意：電池健康、溫度、電量、無線功率、輸入輸出瓦數與電池安全警示">
        <div class="dial">
          <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="42" stroke="#26262b" stroke-width="7" fill="none"/><circle class="arc" cx="50" cy="50" r="42" stroke="#b5e941" stroke-width="7" fill="none" stroke-linecap="round" stroke-dasharray="264" stroke-dashoffset="264" transform="rotate(-90 50 50)" data-p=".98"/><text x="50" y="55" text-anchor="middle" fill="#fff" font-size="24" font-weight="700" class="cnt" data-to="98">0</text></svg>
          <div class="unit">電池健康 %</div>
        </div>
        <div class="dial">
          <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="42" stroke="#26262b" stroke-width="7" fill="none"/><circle class="arc" cx="50" cy="50" r="42" stroke="#b5e941" stroke-width="7" fill="none" stroke-linecap="round" stroke-dasharray="264" stroke-dashoffset="264" transform="rotate(-90 50 50)" data-p=".33"/><text x="50" y="55" text-anchor="middle" fill="#fff" font-size="24" font-weight="700" class="cnt" data-to="33">0</text></svg>
          <div class="unit">溫度 °C</div>
        </div>
        <div class="dial">
          <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="42" stroke="#26262b" stroke-width="7" fill="none"/><circle class="arc" cx="50" cy="50" r="42" stroke="#b5e941" stroke-width="7" fill="none" stroke-linecap="round" stroke-dasharray="264" stroke-dashoffset="264" transform="rotate(-90 50 50)" data-p="1"/><text x="50" y="55" text-anchor="middle" fill="#fff" font-size="24" font-weight="700" class="cnt" data-to="100">0</text></svg>
          <div class="unit">電量 %</div>
        </div>
        <div class="dial">
          <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="42" stroke="#26262b" stroke-width="7" fill="none"/><circle class="arc" cx="50" cy="50" r="42" stroke="#b5e941" stroke-width="7" fill="none" stroke-linecap="round" stroke-dasharray="264" stroke-dashoffset="264" transform="rotate(-90 50 50)" data-p=".83"/><text x="50" y="55" text-anchor="middle" fill="#fff" font-size="24" font-weight="700" class="cnt" data-to="25">0</text></svg>
          <div class="unit">無線功率 W</div>
        </div>
        <div class="dial">
          <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="42" stroke="#26262b" stroke-width="7" fill="none"/><circle class="arc" cx="50" cy="50" r="42" stroke="#b5e941" stroke-width="7" fill="none" stroke-linecap="round" stroke-dasharray="264" stroke-dashoffset="264" transform="rotate(-90 50 50)" data-p=".75"/><text x="50" y="55" text-anchor="middle" fill="#fff" font-size="24" font-weight="700" class="cnt" data-to="30">0</text></svg>
          <div class="unit">輸入／輸出 W</div>
        </div>
        <div class="dial">
          <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="42" stroke="#26262b" stroke-width="7" fill="none"/><circle class="arc" cx="50" cy="50" r="42" stroke="#e5322d" stroke-width="7" fill="none" stroke-linecap="round" stroke-dasharray="264" stroke-dashoffset="264" transform="rotate(-90 50 50)" data-p="1"/><text x="50" y="58" text-anchor="middle" fill="#e5322d" font-size="34" font-weight="800">!</text></svg>
          <div class="unit">電池安全警示</div>
        </div>
      </div>
    </div>
  </section>

  

  <section class="sec scene" id="coffee" style="padding-top:20px">
    <div class="wrap">
      <div class="scene-frame" style="background:linear-gradient(rgba(255,255,255,.22),rgba(255,255,255,.08)),url({{ 'tsp-daily-dine-full.jpg' | asset_url }}) center 9.4%/cover no-repeat;aspect-ratio:50/49">
        <div class="scene-title daily-coffee-copy"><h2>咖啡還沒涼，<br>電已經回來了。</h2></div>
        
        <span class="scene-cap"><b>日常情境</b><span>支架＋磁吸同框</span></span>
      </div>
    </div>
  </section>

  

  


  

  

  <section class="sec" style="padding-top:20px">
    <div class="wrap">
      <div class="sec-head center">
        <h2>R 角，放在一起毫無違和。</h2>
        <p class="lede">整塊鋁合金 CNC 成型，R 角做得圓潤服貼——跟 MacBook 疊在一起，像原生配件。蘋果迷會懂。</p>
      </div>
      <img src="{{ 'tsp-daily-ts-corner.webp' | asset_url }}" alt="MacBook 邊角，R 角圓潤服貼" style="display:block;width:100%;max-width:1060px;margin:0 auto;border-radius:24px">
    </div>
  </section>

  <section class="sec scene" style="padding-bottom:0;padding-top:20px">
    <div class="wrap">
      <div class="scene-frame" style="background:url('{{ 'tsp-bg-daily-1.jpg' | asset_url }}') center 31%/cover no-repeat;aspect-ratio:10/7">
        <div class="scene-title"><h2 style="color:#f5f5f7;text-shadow:0 2px 24px rgba(0,0,0,.35)">出門一整天，<br>不帶充電焦慮。</h2></div>
        
        <span class="scene-cap"><b>10,000mAh</b><span>iPhone 約 1.7 次的底氣</span></span>
      </div>
    </div>
  </section>
</div></div>
{% schema %}
{ "name": "TSP daily", "settings": [] }
{% endschema %}
