{{ 'ts-air.css' | asset_url | stylesheet_tag }}
<div class="ts-topbar" data-hide-app="{% if section.settings.hide_app_bar %}1{% else %}0{% endif %}">
  <div class="ts-topbar__in">

    <a class="ts-topbar__name" href="{{ product.url }}" data-gc-air-top>{{ section.settings.product_label }}</a>

    <nav class="ts-topbar__links" aria-label="{{ section.settings.product_label }}">
      <a href="#safety">安全</a>
      <a href="#inside">結構</a>
      <a href="#thin">輕薄</a>
      <a href="#charge">充電</a>
      <a href="#spec">規格</a>
    </nav>

    {%- comment -%} 2026-08-19（Mars 拍板）：不再直接加車（會盲加石墨黑）——
        改跳到頁尾購買卡（#buy）先選顏色再加入購物車 {%- endcomment -%}
    <a class="ts-topbar__buy" href="#buy">{{ section.settings.button_label }}</a>

  </div>
</div>
<div class="ts-topbar__spacer" aria-hidden="true"></div>

<script src="{{ 'ts-topbar.js' | asset_url }}" defer></script>

<script src="{{ 'ts-cart.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "TS Air 頂部列",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo（留空就用主題頁首那一顆）" },
    { "type": "text", "id": "home_label", "label": "Logo 的替代文字（點了回首頁）", "default": "grantclassic" },
    { "type": "text", "id": "product_label", "label": "商品名", "default": "TITANSHIELD Air" },
    { "type": "text", "id": "button_label", "label": "購買按鈕", "default": "購買" },
    { "type": "checkbox", "id": "hide_app_bar", "default": true,
      "label": "隱藏 App 的行銷列（Vitals 折扣券那條）",
      "info": "只影響這一頁，其他頁面照舊。取消勾選就會回來。" }
  ],
  "presets": [
    {
      "name": "TS Air 頂部列"
    }
  ]
}
{% endschema %}
