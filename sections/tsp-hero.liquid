{{ 'tsp-pro.css' | asset_url | stylesheet_tag }}
<div class="tsp-pro"><div class="act-dark">
<header class="topbar ts-topbar">
  <div class="wrap ts-topbar__in">
    <span class="brand">
      <a class="name ts-topbar__name" href="{{ product.url }}" data-gc-air-top>TITANSHIELD Pro</a>
    </span>
    <span class="right">
      <nav class="spy" aria-label="頁內導覽">
        <a href="#safety" data-spy="safety">安全</a>
        <a href="#charge" data-spy="charge">快充</a>
        <a href="#daily" data-spy="daily">日常</a>
        <a href="#compare" data-spy="compare">比較</a>
      </nav>
      <a class="btn btn-buy ts-topbar__buy" href="#buy">購買</a>
    </span>
  </div>
</header>
<div class="ts-topbar__spacer" aria-hidden="true"></div>

<!-- ═════════ 黑章：安全 ═════════ -->


  <div class="hero-pinwrap" id="heropin">
<section class="hero" id="hero">
    <div class="hero-stage" aria-hidden="true" style="background:linear-gradient(rgba(6,7,10,.52),rgba(6,7,10,.66)),url('{{ 'tsp-bg-hero-2.jpg' | asset_url }}') center/cover no-repeat"></div>
    <div class="wrap hero-layout">
      <div class="hero-copy">
        <p class="hero-cn">穩如鈦山 Pro・防爆固態行動電源</p>
        <h1>TITANSHIELD <span class="hero-pro">Pro</span></h1>
        <p class="hero-tagline">只發電，不發火。安全，聽得見。</p>
        <div class="ctas">
          <a class="btn hero-buy" href="#buy" aria-label="立即購買 TITANSHIELD Pro">
            <span>立即購買</span>
            <svg class="hero-buy-icon" viewBox="0 0 18 18" aria-hidden="true"><path d="M6.5 3.75 11.75 9 6.5 14.25"/></svg>
          </a>
          <button class="film-chip" type="button" id="filmchip" aria-haspopup="dialog">
            <video class="film-chip-loop" autoplay muted loop playsinline preload="metadata" poster="{{ 'tsp-film-thumb.jpg' | asset_url }}" src="{{ 'tsp-film-loop.mp4' | asset_url }}" aria-hidden="true" tabindex="-1"></video>
            <span id="filmchip-label">介紹影片</span>
            <svg class="film-chip-icon" viewBox="0 0 14 14" aria-hidden="true"><path d="M4.4 2.6v8.8L11.4 7z" fill="currentColor"/></svg>
          </button>
        </div>
      </div>
      <div class="hero-product-pair" id="heroprod" role="img" aria-label="穩如鈦山 Pro 黑色與銀色款">
        <img class="hero-black" src="{{ 'tsp-hero-titanshield-pro-black.webp' | asset_url }}" alt="穩如鈦山 Pro 黑色款">
        <img class="hero-silver" src="{{ 'tsp-hero-titanshield-pro-silver.webp' | asset_url }}" alt="穩如鈦山 Pro 銀色款">
      </div>
    </div>
    <div class="fgm" id="fgm" hidden aria-hidden="true">
      <video id="fgm-video" muted loop playsinline preload="none" poster="{{ 'tsp-film-thumb.jpg' | asset_url }}" data-src="{{ 'tsp-film-720.mp4' | asset_url }}" tabindex="-1"></video>
      <button class="fgm-full film-open" type="button">
        <svg viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8.2 2.2h3.6v3.6M11.8 2.2 7.6 6.4M5.8 2.6H3.4a1.2 1.2 0 0 0-1.2 1.2v7a1.2 1.2 0 0 0 1.2 1.2h7a1.2 1.2 0 0 0 1.2-1.2V8.2"/></svg>
        <span>觀看完整影片</span>
      </button>
    </div>
  </section>
</div>
</div></div>
<script>window.TSP_ASSET_BASE = {{ 'tsp-pro.js' | asset_url | json }}.replace(/tsp-pro\.js[^/]*$/, '');</script>
<script src="{{ 'tsp-pro.js' | asset_url }}" defer></script>

<div class="tsp-pro">
  <div class="film-modal" id="filmmodal" role="dialog" aria-modal="true" aria-label="穩如鈦山 Pro 形象影片" hidden>
    <button class="film-close" type="button" id="filmclose" aria-label="關閉影片">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
    <div class="film-embed"><iframe id="filmframe" title="穩如鈦山 Pro 形象影片" data-embed="https://www.youtube-nocookie.com/embed/86WCHRdLJrc" allow="autoplay; encrypted-media; fullscreen" allowfullscreen frameborder="0"></iframe></div>
  </div>
</div>
{% schema %}
{ "name": "TSP hero", "settings": [] }
{% endschema %}
