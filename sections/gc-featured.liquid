{%- comment -%}
  gc-featured ── 首頁「編輯精選文章」（2026-08-30）

  Mars 拍板「四欄緊湊」，而且「四欄要能一直往後延伸（6 或 7 個）」。
  所以是橫向捲軸：看得到四張，往右滑看後面的；第五張露出一角當訊號。

  文章從哪來：後台選一個部落格，這裡自動抓最新的 N 篇。
  不需要一篇一篇建區塊——寫了新文章首頁自己會換。

  要還原：把首頁的這個區塊刪掉，再刪 sections/gc-featured.liquid 與 assets/gc-blog.css。
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign bl = blogs[s.blog]
  assign n = s.count
  # 沒指到部落格就整段不出現，不要留一個空殼在首頁上
  if bl == blank or bl.articles_count == 0
    assign n = 0
  endif
-%}

{%- if n > 0 -%}
  {{ 'gc-blog.css' | asset_url | stylesheet_tag }}

  <section class="gc-feat{% if s.bleed %} gc-feat--bleed{% endif %}" style="--gcf-max:var(--container-max-width,1600px);--gcf-gut:var(--container-gutter,40px);--gcf-ratio:{{ s.ratio | default: '4/3' }};--gcf-ttl:var(--gc-t4,21px);--gcf-basis-m:calc(100% - 48px);--gcf-ttl-m:17px;--gcf-basis:calc((100% - {{ s.cols | minus: 1 | default: 2 }} * var(--gcf-gap) - var(--gcf-peek)) / {{ s.cols | default: 3 }});--gcf-gap0:{{ s.gap }}px;--gcf-gap0-m:{{ s.gap_mobile }}px;--gcf-t:{{ s.head_size }}px;--gcf-t-m:{{ s.head_size_mobile }}px;--gcf-pt:{{ s.pad_top }}px;--gcf-pb:{{ s.pad_bottom }}px;--gcf-pt-m:{{ s.pad_top_m }}px;--gcf-pb-m:{{ s.pad_bottom_m }}px;">
    <div class="gc-feat__in">

      <div class="gc-feat__hd">
        <h2 class="gc-feat__t">{{ s.heading }}</h2>
        <span class="gc-feat__act">
          {%- if s.more_label != blank -%}
            <a class="gc-feat__more" href="{{ s.more_url | default: bl.url }}">
              {{ s.more_label }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </a>
          {%- endif -%}
          {%- if s.show_arrows -%}
            <span class="gc-feat__arrows" data-gcf-arrows>
              <button type="button" data-gcf-dir="-1" aria-label="上一批文章">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
              </button>
              <button type="button" data-gcf-dir="1" aria-label="下一批文章">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
              </button>
            </span>
          {%- endif -%}
        </span>
      </div>

      <div class="gc-feat__rail" data-gcf-rail>
        {%- for a in bl.articles limit: n -%}
          {%- liquid
            # 分類：用文章的標籤。但「第一個標籤」是照字母排的、等於隨機，
            # 而且標籤裡混著品牌標語（「有它顧著」）——那不是分類。
            # 所以先濾掉排除名單，濾完沒有才退回部落格名稱。
            # 不要留空——空的那一行會讓卡片高度跟別人差一截。
            assign kick = blank
            assign skip = s.skip_tags | downcase
            for tg in a.tags
              assign probe = tg | downcase
              unless skip contains probe
                assign kick = tg
                break
              endunless
            endfor
            # 沒有可用的標籤就**留空**，不要拿部落格名稱充數——
            # 這個部落格叫「有它顧著」（品牌標語），印在卡片上當分類完全沒有意義。
            # 空的那一行由 CSS 撐住高度，卡片一樣對得齊。
          -%}
          <a class="gc-feat__card" href="{{ a.url }}">
            <span class="gc-feat__thumb">
              {%- if a.image -%}
                {{ a.image | image_url: width: 640 | image_tag:
                   loading: 'lazy', widths: '320,480,640,960',
                   sizes: '(max-width:749px) 45vw, 23vw',
                   alt: a.image.alt | default: a.title | escape }}
              {%- endif -%}
            </span>
            <p class="gc-feat__k">{{ kick }}</p>
            <p class="gc-feat__ttl">{{ a.title }}</p>
          </a>
        {%- endfor -%}
      </div>

    </div>
  </section>

  <script>
  /* 左右箭頭：捲一張卡＋一個間距。
     用事件委派掛在 section 上——主題編輯器改設定會重畫這一段，
     直接掛在按鈕上的監聽會跟著沒了。 */
  (function(){
    var root = document.currentScript && document.currentScript.previousElementSibling;
    if (!root || !root.classList || !root.classList.contains('gc-feat')) {
      root = document.querySelector('.gc-feat');
    }
    if (!root || root.dataset.gcfInit) return;
    root.dataset.gcfInit = '1';
    var rail = root.querySelector('[data-gcf-rail]');
    var box  = root.querySelector('[data-gcf-arrows]');
    if (!rail) return;

    /* ── 按著拖捲動（只給滑鼠）──
       三個實際會出事的地方：
       ① 拖完放開會「順便點開」那張卡 → 位移超過 5px 就在捕捉階段擋掉 click
       ② scroll-snap 會跟拖曳打架（一放手就彈回去）→ 拖的時候關掉
       ③ 拖到容器外面就斷掉 → 用 setPointerCapture 把事件綁住 */
    (function(){
      /* ④ 2026-09-01 修：setPointerCapture 不能在 pointerdown 就抓。
         指標一被容器抓走，瀏覽器就把 click 派給「容器」而不是那張卡的 <a>，
         結果是每一張文章卡點下去都沒反應（正式站實際發生，Mars 回報「部落格都點不了」）。
         改成「真的移動超過門檻才抓」：純點擊全程沒有 capture，連結正常跳轉；
         一旦開始拖才接管，拖出容器也不會斷。 */
      var down = false, x0 = 0, l0 = 0, moved = 0, dragging = false;
      rail.addEventListener('pointerdown', function(e){
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        down = true; dragging = false; x0 = e.clientX; l0 = rail.scrollLeft; moved = 0;
      });
      rail.addEventListener('pointermove', function(e){
        if (!down) return;
        var dx = e.clientX - x0;
        if (Math.abs(dx) > moved) moved = Math.abs(dx);
        if (!dragging && moved > 5) {
          dragging = true;
          rail.classList.add('is-drag');
          try { rail.setPointerCapture(e.pointerId); } catch (err) {}
        }
        if (dragging) rail.scrollLeft = l0 - dx;
      });
      function end(e){
        if (!down) return;
        down = false;
        if (dragging) {
          rail.classList.remove('is-drag');
          try { rail.releasePointerCapture(e.pointerId); } catch (err) {}
        }
        dragging = false;
      }
      rail.addEventListener('pointerup', end);
      rail.addEventListener('pointercancel', end);
      rail.addEventListener('click', function(e){
        if (moved > 5) { e.preventDefault(); e.stopPropagation(); moved = 0; }
      }, true);
    })();

    function step(dir){
      var card = rail.querySelector('.gc-feat__card');
      if (!card) return;
      var gap = parseFloat(getComputedStyle(rail).gap) || 24;
      rail.scrollBy({ left: (card.getBoundingClientRect().width + gap) * dir, behavior:'smooth' });
    }
    function sync(){
      if (!box) return;
      var max = rail.scrollWidth - rail.clientWidth;
      box.querySelector('[data-gcf-dir="-1"]').disabled = rail.scrollLeft <= 2;
      box.querySelector('[data-gcf-dir="1"]').disabled  = rail.scrollLeft >= max - 2;
    }
    if (box) box.addEventListener('click', function(e){
      var b = e.target.closest('[data-gcf-dir]');
      if (b) step(Number(b.dataset.gcfDir));
    });
    rail.addEventListener('scroll', sync, { passive:true });
    sync();
    addEventListener('resize', sync);
  })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "精選文章",
  "tag": "section",
  "class": "gc-feat-sec",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "標題",
      "default": "編輯精選文章"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "從哪個部落格抓文章",
      "info": "抓最新的幾篇，寫了新文章首頁自己會換，不用回來改。"
    },
    {
      "type": "range",
      "id": "count",
      "label": "顯示幾篇",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12,
      "info": "其餘往右滑（滑鼠可以按著拖）。上限放到 24——Mars 2026-08-31：要一直往後延伸，不要看起來像被截斷。"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "顯示左右箭頭（電腦版）",
      "default": true,
      "info": "手機不顯示，用手指滑就好。"
    },
    {
      "type": "text",
      "id": "skip_tags",
      "label": "不要當分類的標籤",
      "default": "有它顧著",
      "info": "卡片上那行小字用文章的標籤。標籤裡混著品牌標語之類不是分類的字，寫在這裡就會跳過、改用下一個標籤。多個用逗號隔開。"
    },
    {
      "type": "header",
      "content": "看更多"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "按鈕文字",
      "default": "看更多",
      "info": "留空就不顯示這顆。"
    },
    {
      "type": "url",
      "id": "more_url",
      "label": "連到哪裡",
      "info": "留空就連到上面選的那個部落格首頁。"
    },
    {
      "type": "header",
      "content": "間距"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "卡片間距（電腦）",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "卡片間距（手機）",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "bleed",
      "label": "捲軸延伸到螢幕邊緣",
      "default": true,
      "info": "關掉的話卡片會停在版面的右邊界，右側留一塊空白——看起來像「只有這幾張」。"
    },
    {
      "type": "range",
      "id": "cols",
      "label": "一排看得到幾張（電腦）",
      "min": 3, "max": 5, "step": 1, "default": 3,
      "info": "3 張＝卡片約 430px，跟隔壁櫥窗的卡片同大小；4 張＝約 330px。"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "文章圖片比例",
      "default": "4/3",
      "options": [
        { "value": "16/9", "label": "16:9 · 最扁（文章頁用這個）" },
        { "value": "3/2",  "label": "3:2 · 中間" },
        { "value": "4/3",  "label": "4:3 · 最有份量（首頁建議）" }
      ]
    },
    {
      "type": "range",
      "id": "head_size",
      "label": "段落標題字級（電腦）",
      "min": 24,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 32,
      "info": "首頁其他段落的標題是 40，要跟它們一致就設 40；文章頁裡設 32 比較不會壓過內文。"
    },
    {
      "type": "range",
      "id": "head_size_mobile",
      "label": "段落標題字級（手機）",
      "min": 18,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "上方留白（電腦）",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "下方留白（電腦）",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "pad_top_m",
      "label": "上方留白（手機）",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "pad_bottom_m",
      "label": "下方留白（手機）",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "精選文章"
    }
  ]
}
{% endschema %}
