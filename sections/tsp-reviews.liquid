<div class="tsp-pro"><div class="act-light">
<section class="sec tsp-rev" id="reviews" aria-label="顧客評價">
  <div class="wrap">
    <div class="sec-head center" style="margin-bottom:28px">
      <p class="eyebrow">顧客評價</p>
      <h2>大家怎麼說。</h2>
    </div>
    <div class="tsp-rev-widget">
      <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}" data-product-title="{{ product.title | escape }}">
        {{ product.metafields.judgeme.widget }}
      </div>
    </div>
  </div>
</section>
</div></div>
{% schema %}
{ "name": "TSP reviews", "settings": [] }
{% endschema %}
