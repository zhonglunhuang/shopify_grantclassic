{%- assign kg_article = article.metafields.grantclassic_kg.article_schema -%}
{%- assign kg_out = kg_article -%}
{%- assign kg_pub_day = article.published_at | date: '%Y-%m-%d' -%}
  {%- assign kg_upd_day = article.updated_at | date: '%Y-%m-%d' -%}
  {%- if kg_upd_day != kg_pub_day -%}
    {%- assign kg_dm = kg_out | split: '"dateModified"' -%}
    {%- if kg_dm.size == 2 -%}
      {%- assign kg_v = kg_dm[1] | split: '"' -%}
      {%- if kg_v.size > 2 -%}
        {%- capture kg_old_pair -%}{{ kg_v[0] }}"{{ kg_v[1] }}"{%- endcapture -%}
        {%- assign kg_rest = kg_dm[1] | remove_first: kg_old_pair -%}
        {%- capture kg_out -%}{{ kg_dm[0] }}"dateModified":"{{ article.updated_at | date: '%Y-%m-%dT%T' }}"{{ kg_rest }}{%- endcapture -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
<pre style="padding:20px;font:13px/1.7 ui-monospace,monospace;white-space:pre-wrap">
TS_PROBE_START
published={{ kg_pub_day }}  updated={{ kg_upd_day }}
換完的 dateModified={{ kg_out | split: '"dateModified"' | last | split: ',' | first }}
JSON 還完整嗎（尾巴 40 字）={{ kg_out | slice: -40, 40 | escape }}
TS_PROBE_END
</pre>
{% schema %}
{ "name": "TS 診斷：文章正文", "tag": "section" }
{% endschema %}
