{%- comment -%} 診斷：把 main-article 對中繼欄位做的手術原封不動跑一次，看結果 {%- endcomment -%}
{%- assign kg_article = article.metafields.grantclassic_kg.article_schema -%}
{%- assign kg_out = kg_article -%}
{%- assign kg_pub_day = article.published_at | date: '%Y-%m-%d' -%}
{%- assign kg_upd_day = article.updated_at | date: '%Y-%m-%d' -%}
{%- if kg_upd_day != kg_pub_day -%}
  {%- capture kg_mod_old -%}"dateModified":"{{ kg_pub_day }}"{%- endcapture -%}
  {%- capture kg_mod_new -%}"dateModified":"{{ kg_upd_day }}"{%- endcapture -%}
  {%- assign kg_out = kg_out | replace: kg_mod_old, kg_mod_new -%}
{%- endif -%}
<pre style="padding:20px;font:13px/1.7 ui-monospace,monospace;white-space:pre-wrap">
TS_PROBE_START
handle={{ article.handle }}
published_day={{ kg_pub_day }}
updated_day={{ kg_upd_day }}
有中繼欄位={% if kg_article %}YES{% else %}NO{% endif %}
要找的字串={{ kg_mod_old | escape }}
換成={{ kg_mod_new | escape }}
原本含有要找的字串={% if kg_article contains kg_mod_old %}YES{% else %}NO{% endif %}
換完之後的 dateModified={{ kg_out | split: '"dateModified":"' | last | split: '"' | first }}
TS_PROBE_END
</pre>
{% schema %}
{ "name": "TS 診斷：文章正文", "tag": "section" }
{% endschema %}
